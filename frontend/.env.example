# NeoCampus Frontend Environment Variables
# In production, points to the Render backend service:
VITE_API_BASE_URL=https://neocampus-wylk.onrender.com/api

# For local development with backend on port 8000 (leave blank to default to http://127.0.0.1:8000/api):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
